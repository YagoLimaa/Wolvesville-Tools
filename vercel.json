{
  "version": 2,
  "builds": [
    {
      "src": "main/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "front/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/main/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/front/$1"
    }
  ]
}
