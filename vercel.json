{
  "version": 2,
  "builds": [
    {
      "src": "front/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "main/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/main/index.js"
    },
    {
      "source": "/images/:path*",
      "destination": "/main/public/images/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/front/dist/assets/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/front/dist/index.html"
    }
  ]
}
